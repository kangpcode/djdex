{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DJDeX",
  "version": "0.12.0",
  "identifier": "com.kangpcode.djdex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DJDeX By Kangpcode",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#04060a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Virtual DJ workstation",
    "longDescription": "DJDeX By Kangpcode - software workstation DJ profesional dengan dua hingga empat deck, mixer 4 channel, sampler 16-step sequencer, efek audio, library SQLite, MIDI mapping, dan perekam audio master mix.",
    "copyright": "Copyright (c) 2026 Kangpcode",
    "resources": [
      "../skins/classic-club/skin.json",
      "../skins/battle-scratch/skin.json",
      "../skins/producer-remix/skin.json",
      "../skins/tour-pro/skin.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "section": "sound"
      },
      "rpm": {
        "depends": [
          "alsa-lib",
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3"
        ],
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
