{
  "metadata": {
    "id": "tour-pro",
    "name": "Tour Pro",
    "author": "Kangpcode",
    "version": "1.1.0",
    "description": "Tata letak tur/festival: waveform lebar dan tinggi, piringan vinyl standar, phase sync strip aktif, serta palet empat aksen untuk cue bank."
  },
  "theme": {
    "primaryColor": "#38bdf8",
    "accentDeckA": "#38bdf8",
    "accentDeckB": "#f97316",
    "accentDeckC": "#10b981",
    "accentDeckD": "#f43f5e",
    "backgroundColor": "#080c14",
    "surfaceColor": "#0f172a",
    "panelBorderColor": "#1e293b",
    "textColor": "#f8fafc",
    "fontFamily": "Inter, sans-serif"
  },
  "layout": {
    "deckCount": 2,
    "waveform": {
      "position": "top-stacked",
      "orientation": "horizontal",
      "heightPx": 164,
      "showBeatgrid": true
    },
    "platter": {
      "size": "standard",
      "vinylTexture": true,
      "centerDisplay": false
    },
    "mixer": {
      "position": "center",
      "channelCount": 2,
      "vuMeterStyle": "gradient",
      "crossfaderHeightPx": 44
    },
    "lowerPanelDefault": "library",
    "showPhaseStrip": true,
    "showScratchPads": false
  }
}
